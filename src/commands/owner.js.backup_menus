      }

      const novoNome = args.join(' ').trim()

      if (!novoNome) {
        return reply(
          `❌ Informe o novo nome.\n\nExemplo: ${config.prefix}nomedono Mestre\n\nPara voltar ao padrão: ${config.prefix}nomedono padrão`
        )
      }

      const db = await getDatabase()
      db.data.groups[groupJid] ||= {}

      if (['padrão', 'padrao', 'normal', 'reset'].includes(novoNome.toLowerCase())) {
        delete db.data.groups[groupJid].nomeDono
        await db.write()
        return reply('✅ O nome do menu voltou para *DONO* neste grupo.')
      }

      if (novoNome.length > 30) {
        return reply('❌ O nome deve ter no máximo 30 caracteres.')
