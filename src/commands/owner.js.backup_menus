  {
    name: 'alterarfonte',
    aliases: ['fontebot', 'fontedobot'],

    async execute({ reply, sender, args }) {
      if (!(await ehDonoBot(sender))) {
        return reply('❌ Você não possui permissão de dono.')
      }

      const fonte = args?.join(' ').trim()

      if (!fonte) {
        return reply(
          '🔤 *ALTERAR FONTE*\n\n' +
          'Use:\n' +
          `${config.prefix}alterarfonte nome da fonte\n\n` +
          'Exemplos:\n' +
          `▸ ${config.prefix}alterarfonte negrito\n` +
          `▸ ${config.prefix}alterarfonte italico\n` +
          `▸ ${config.prefix}alterarfonte manuscrita\n` +
          `▸ ${config.prefix}alterarfonte medieval\n` +
          `▸ ${config.prefix}alterarfonte dupla\n` +
          `▸ ${config.prefix}alterarfonte monospace\n` +
          `▸ ${config.prefix}alterarfonte normal`
        )
      }

      const fontesPermitidas = [
        'normal',
        'negrito',
        'italico',
        'itálico',
        'manuscrita',
        'medieval',
        'dupla',
        'monospace'
      ]

      const nomeFonte = fonte.toLowerCase()

      if (!fontesPermitidas.includes(nomeFonte)) {
        return reply(
