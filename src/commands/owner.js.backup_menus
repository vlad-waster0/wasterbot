        await db.write()
        return reply('✅ Fonte do *bem-vindo* alterada para 𝑺𝒆𝒓𝒊𝒇 𝑩𝒐𝒍𝒅 𝑰𝒕𝒂𝒍𝒊𝒄 neste grupo.')
      }

      if (['normal', 'padrao', 'padrão'].includes(opcao)) {
        db.data.groups[groupJid].welcome.fontStyle = 'normal'
        await db.write()
        return reply('✅ Fonte do *bem-vindo* voltou ao normal neste grupo.')
      }

      return reply(
        `❌ Opção inválida. Use:\\n` +
        `▸ ${config.prefix}fontbemvindo serif\\n` +
        `▸ ${config.prefix}fontbemvindo normal`
      )
    },
  },

  {
      name: 'alterarsaida',
      aliases: ['configsaida', 'saida'],
      description: 'Altera a mensagem de saída neste grupo.',
      async execute({ message, sender, args, textoCompleto, reply }) {
        if (!(await ehDonoBot(sender))) {
          return reply('❌ Você não possui permissão de dono.')
        }

        const groupJid = message?.key?.remoteJid

        if (!groupJid?.endsWith('@g.us')) {
          return reply('❌ Este comando só pode ser usado em grupos.')
        }

        const db = await getDatabase()

        db.data.groups[groupJid] ||= {}
        db.data.groups[groupJid].leave ||= {}

        if (!args?.length) {
          const leave = db.data.groups[groupJid].leave
          const mensagem = leave.message || '👋 @usuário saiu do grupo.'
          const status = leave.enabled ? '🟢 ATIVADO' : '🔴 DESATIVADO'

          return reply(
            `╭━━━〔 👋 SAÍDA DO GRUPO 〕━━━╮\n` +
