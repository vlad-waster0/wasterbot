  {
    name: 'nomedono',
    aliases: ['alterarnomedono'],
    description: 'Altera o nome exibido no menu de dono deste grupo.',
    async execute({ reply, sender, args, message }) {
      if (!(await ehDonoBot(sender))) {
        return reply('❌ Você não possui permissão de dono.')
      }

