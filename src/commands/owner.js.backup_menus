            `💬 *Mensagem atual:*\n${mensagem}\n\n` +
            `⚙️ *Use:*\n` +
            `▸ ${config.prefix}alterarsaida sua mensagem aqui\n\n` +
            `🔖 Use *@usuário* para mencionar automaticamente quem saiu.\n` +
            `╰━━━━━━━━━━━━━━━━━━━━╯`
          )
        }

        const mensagem = String(textoCompleto || '')
          .replace(/\\n/g, '\n')
          .replace(/\\r/g, '')
          .trim()

        if (mensagem.length > 1000) {
          return reply('❌ A mensagem pode ter no máximo 1000 caracteres.')
        }

        db.data.groups[groupJid].leave.message = mensagem

        if (db.data.groups[groupJid].leave.fontStyle === undefined) {
          db.data.groups[groupJid].leave.fontStyle = 'serif_bold_italic'
        }

        await db.write()

        return reply(
          `✅ *MENSAGEM DE SAÍDA ATUALIZADA!*\n\n` +
          `💬 *Nova mensagem:*\n${mensagem}\n\n` +
          `👤 Use *@usuário* para mencionar automaticamente quem saiu.`
        )
      },
    },

    {
