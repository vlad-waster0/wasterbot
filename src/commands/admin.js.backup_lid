import { config } from '../config.js'

const groupMetadataCache = new Map()
const GROUP_METADATA_CACHE_MS = 60 * 1000

async function obterMetadataGrupo(sock, groupJid) {
  const agora = Date.now()
  const cache = groupMetadataCache.get(groupJid)

  if (cache && agora - cache.timestamp < GROUP_METADATA_CACHE_MS) {
    return cache.metadata
  }

  const metadata = await sock.groupMetadata(groupJid)

  groupMetadataCache.set(groupJid, {
    metadata,
    timestamp: agora,
  })

  return metadata
}

export async function isGroupAdmin(sock, groupJid, sender, message) {
  if (!groupJid?.endsWith('@g.us')) return false

  try {
    const metadata = await obterMetadataGrupo(sock, groupJid)

    const participantIds = [
      sender,
      message?.key?.participant,
      message?.key?.participantAlt,
    ]
      .filter(Boolean)
      .map(String)

    const normalizar = (id) => {
      if (!id) return ''
      return String(id).split('@')[0].split(':')[0]
    }

    const idsNormalizados = participantIds.map(normalizar)

    const member = (metadata.participants || []).find((p) => {
      const ids = [
        p.id,
        p.lid,
        p.phoneNumber,
      ]
        .filter(Boolean)
        .map(String)

      return ids.some((id) =>
        participantIds.includes(id) ||
        idsNormalizados.includes(normalizar(id))
      )
    })

    return member?.admin === 'admin' || member?.admin === 'superadmin'
  } catch (error) {
    console.error('ERRO AO VERIFICAR ADMIN:', error)
    return false
  }
}

export const adminMenuCommand = {
  name: 'menuadm',
  aliases: ['adm', 'admin'],
  description: 'Exibe o menu de administração.',

  async execute({ reply, sender, sock, message }) {
    const groupJid = message.key.remoteJid

    if (!groupJid?.endsWith('@g.us')) {
      return reply('❌ Este comando só pode ser usado em grupos.')
    }

    const admin = await isGroupAdmin(sock, groupJid, sender, message)

    if (!admin) {
      return reply('❌ Este menu é exclusivo para administradores.')
    }

    const p = config.prefix

    return reply(`╭━━━━━━「 🛡️ ADMIN 」━━━━━━╮
🛡️ *ADMINISTRAÇÃO & SEGURANÇA*
 🪙 *GERENCIAMENTO DE GOLD*
 ▸ ${p}addgold @usuário quantidade
 ▸ ${p}tirargold @usuário quantidade
 ▸ ${p}setgold @usuário quantidade


👥 *MEMBROS*
▸ ${p}expulsar @usuário
▸ ${p}adicionar 5511999999999
▸ ${p}promover @usuário
▸ ${p}rebaixar @usuário

⚠️ *ADVERTÊNCIAS*
▸ ${p}advertir @usuário motivo
▸ ${p}advertencias @usuário
▸ ${p}removeradvertencia @usuário

🔇 *CONTROLE DE CHAT*
▸ ${p}mute @usuário
▸ ${p}desmute @usuário
▸ ${p}lista_negra @usuário
▸ ${p}remover_lista_negra @usuário
▸ ${p}mencionar
▸ ${p}reportar

🚪 *ENTRADA E SAÍDA*
▸ ${p}ativarbemvindo
▸ ${p}desativarbemvindo
▸ ${p}ativarsaida
▸ ${p}desativarsaida

⚙️ *CONFIGURAÇÕES DO GRUPO*
▸ ${p}configurar
▸ ${p}horariogrupo
▸ ${p}cancelarhorario
▸ ${p}fechargrupo
▸ ${p}abrirgrupo
▸ ${p}bemvindo
▸ ${p}editarregras <novas regras>
▸ ${p}ativarbemvindo
▸ ${p}desativarbemvindo
▸ ${p}antilink
▸ ${p}antipalavra


🚫 *PROTEÇÃO*
▸ ${p}antilink
▸ ${p}antipalavra
▸ ${p}lista_negra
▸ ${p}remover_lista_negra

📢 *OUTROS*
▸ ${p}reportar
▸ ${p}mencionar

⚠️ *IMPORTANTE*
Os comandos de administração exigem que o usuário
seja administrador do grupo e, quando necessário,
que o bot também seja administrador.

╰━━━━━━━━━━━━━━━━━━━━━━╯`)
  },
}
