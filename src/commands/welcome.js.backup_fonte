import { config } from '../config.js'
import { getDatabase } from '../database.js'
import { isGroupAdmin } from './admin.js'

export const welcomeCommands = [
  {
    name: 'ativarbemvindo',
    description: 'Ativa as boas-vindas do grupo.',
    async execute({ sock, message, sender, reply }) {
      const groupJid = message.key.remoteJid

      if (!groupJid?.endsWith('@g.us')) {
        return reply('❌ Este comando só pode ser usado em grupos.')
      }

      if (!(await isGroupAdmin(sock, groupJid, sender, message))) {
        return reply('❌ Apenas administradores podem ativar o bem-vindo.')
      }

      const db = await getDatabase()

      db.data.groups[groupJid] ||= {}
      db.data.groups[groupJid].welcome ||= {}
      db.data.groups[groupJid].welcome.enabled = true

      await db.write()

      return reply(
        '✅ *BEM-VINDO ATIVADO!*\n\n' +
        '👋 Agora vou enviar uma mensagem com a foto de perfil quando alguém entrar no grupo.'
      )
    },
  },

  {
    name: 'desativarbemvindo',
    description: 'Desativa as boas-vindas do grupo.',
    async execute({ sock, message, sender, reply }) {
      const groupJid = message.key.remoteJid

      if (!groupJid?.endsWith('@g.us')) {
        return reply('❌ Este comando só pode ser usado em grupos.')
      }

      if (!(await isGroupAdmin(sock, groupJid, sender, message))) {
        return reply('❌ Apenas administradores podem desativar o bem-vindo.')
      }

      const db = await getDatabase()

      db.data.groups[groupJid] ||= {}
      db.data.groups[groupJid].welcome ||= {}
      db.data.groups[groupJid].welcome.enabled = false

      await db.write()

      return reply('🔴 *BEM-VINDO DESATIVADO!*')
    },
  },

  {
    name: 'configbemvindo',
    aliases: ['bemvindo'],
    description: 'Configura a mensagem de boas-vindas.',
    async execute({ sock, message, sender, args, reply }) {
      const groupJid = message.key.remoteJid

      if (!groupJid?.endsWith('@g.us')) {
        return reply('❌ Este comando só pode ser usado em grupos.')
      }

      if (!(await isGroupAdmin(sock, groupJid, sender, message))) {
        return reply('❌ Apenas administradores podem configurar o bem-vindo.')
      }

      const db = await getDatabase()

      db.data.groups[groupJid] ||= {}
      db.data.groups[groupJid].welcome ||= {}

      if (!args?.length) {
        const welcome = db.data.groups[groupJid].welcome
        const mensagem =
          welcome.message ||
          '👋 Seja bem-vindo(a), @usuário!\n🎉 É um prazer ter você no grupo!'

        const status = welcome.enabled ? '🟢 ATIVADO' : '🔴 DESATIVADO'

        return reply(
          `╭━━━〔 👋 BEM-VINDO 〕━━━╮

📌 *Status:* ${status}

📸 *Foto de perfil:* ATIVADA
👤 *Menção:* ATIVADA

💬 *Mensagem atual:*
${mensagem}

⚙️ *Comandos:*
▸ ${config.prefix}ativarbemvindo
▸ ${config.prefix}desativarbemvindo
▸ ${config.prefix}configbemvindo sua mensagem aqui

🔖 Use *@usuário* para mencionar automaticamente quem entrou.

╰━━━━━━━━━━━━━━━━━━━━╯`
        )
      }

      const mensagem = args.join(' ').trim()

      if (mensagem.length > 1000) {
        return reply('❌ A mensagem pode ter no máximo 1000 caracteres.')
      }

      db.data.groups[groupJid].welcome.message = mensagem

      await db.write()

      return reply(
        `✅ *MENSAGEM DE BEM-VINDO ATUALIZADA!*\n\n` +
        `💬 *Nova mensagem:*\n${mensagem}\n\n` +
        `👤 Use *@usuário* para mencionar automaticamente o novo membro.`
      )
    },
  },
]
