function normalizar(texto) {
  return String(texto || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^\p{L}\p{N}\s]/gu, '')
    .replace(/\s+/g, ' ')
    .trim()
}

function escolher(lista) {
  return lista[Math.floor(Math.random() * lista.length)]
}

function respostaCorreta(resposta, respostas) {
  const valor = normalizar(resposta)
  return respostas.some((r) => {
    const certa = normalizar(r)
    return valor === certa || (certa.length >= 5 && valor.includes(certa))
  })
}

async function premiar(jid, gold) {
  const db = await getDatabase()
  const usuario = db.data.users[jid] || { jid, gold: 0 }
  usuario.gold = Number(usuario.gold || 0) + gold
  db.data.users[jid] = usuario
  await db.write()
}

export function responderJogo(jid, sender, texto) {
  const partida = partidas.get(jid)
  if (!partida || partida.encerrada) return null

  if (!respostaCorreta(texto, partida.respostas)) return null

  partida.encerrada = true
  partidas.delete(jid)

  return {
    tipo: 'acerto',
    sender,
    gold: 10,
    pergunta: partida.pergunta,
  }
}

async function iniciarJogo({ reply, message, sender, tipo, nome }) {
  const jid = message.key.remoteJid

  if (!jid?.endsWith('@g.us')) {
    return reply('❌ Os jogos só podem ser iniciados em grupos.')
  }

  if (partidas.has(jid)) {
    return reply('⚠️ Já existe um jogo acontecendo neste grupo. Responda a pergunta atual primeiro!')
  }

  const lista = perguntas[tipo] || perguntas.quiz
  const item = escolher(lista)

  partidas.set(jid, {
    tipo,
    pergunta: item.p,
    respostas: item.r,
    encerrada: false,
    iniciadoEm: Date.now(),
  })

  return reply(
    `🎮 *${nome}*\n\n` +
    `❓ ${item.p}\n\n` +
    `🏆 Primeiro a acertar ganha *10 Gold*!\n` +
    `💬 Responda normalmente, sem comando.`
  )
}

const definicoes = [
  ['quiz', ['quiz', 'perguntas'], '🧠 QUIZ'],
  ['paises', ['paises', 'países', 'pais'], '🌎 PAÍSES'],
  ['estados', ['estados'], '🇧🇷 ESTADOS BRASILEIROS'],
  ['capitais', ['capitais'], '🏛️ CAPITAIS'],
  ['bandeiras', ['bandeiras', 'bandeira'], '🚩 BANDEIRAS'],
  ['futebol', ['futebol'], '⚽ FUTEBOL'],
  ['matematica', ['matematica', 'matemática', 'math'], '➗ MATEMÁTICA'],
  ['verdadeiro', ['verdadeiro', 'vf', 'v ou f'], '✅ VERDADEIRO OU FALSO'],
  ['animais', ['animais', 'animal'], '🐾 ANIMAIS'],
  ['espaco', ['espaco', 'espaço'], '🚀 ESPAÇO'],
  ['ciencia', ['ciencia', 'ciência'], '🧪 CIÊNCIA'],
  ['conhecimentos', ['conhecimentos', 'geral'], '📚 CONHECIMENTOS GERAIS'],
  ['filmes', ['filmes', 'filme'], '🎬 FILMES'],
  ['musica', ['musica', 'música'], '🎵 MÚSICA'],
  ['comida', ['comida', 'comidas'], '🍔 COMIDA'],
]

export const jogosNovosCommands = definicoes.map(([tipo, aliases, nome]) => ({
  name: tipo,
  aliases,
  description: `Inicia o jogo ${nome}.`,
  async execute(context) {
    return iniciarJogo({
      ...context,
      tipo,
      nome,
    })
  },
}))

export async function processarRespostaDeJogo({ sock, jid, sender, texto, reply }) {
  const resultado = responderJogo(jid, sender, texto)
  if (!resultado) return false

  await premiar(sender, resultado.gold)

  await sock.sendMessage(jid, {
    text:
      `🏆 *RESPOSTA CERTA!*\n\n` +
      `👤 @${sender.split('@')[0]} foi o primeiro a acertar!\n` +
      `🪙 *+${resultado.gold} GOLD*\n\n` +
      `🎮 Rodada encerrada. Use *!quiz* para jogar novamente.`,
    mentions: [sender],
  })

  return true
}

export function existeJogoAtivo(jid) {
  return partidas.has(jid)
}
