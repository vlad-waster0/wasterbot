function aplicarFonteMenu(texto, fonte) {
  if (!texto || fonte === 'normal' || !MAPAS_FONTE_MENU[fonte]) return texto

  const mapa = MAPAS_FONTE_MENU[fonte]
  const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
  const lower = 'abcdefghijklmnopqrstuvwxyz'
  const digits = '0123456789'

  return Array.from(String(texto)).map((c) => {
    let i = upper.indexOf(c)
    if (i >= 0) return Array.from(mapa.upper)[i] || c

    i = lower.indexOf(c)
    if (i >= 0) return Array.from(mapa.lower)[i] || c

    i = digits.indexOf(c)
    if (i >= 0) return Array.from(mapa.digits)[i] || c

    return c
  }).join('')
}

