async function salvarEstilo(groupJid, estilo) {
  const db = await getDatabase()

  db.data.groups[groupJid] ||= {}
  db.data.groups[groupJid].menu ||= {}

  db.data.groups[groupJid].menu.estilo = estilo

  await db.write()
}

