  description: 'Salva um menu personalizado respondendo à mensagem do menu.',
  async execute({ reply, message }) {
    const groupJid = message?.key?.remoteJid

    if (!groupJid?.endsWith('@g.us')) {
      return reply('❌ Este comando só pode ser usado em grupos.')
    }

    const contexto = message?.message?.extendedTextMessage?.contextInfo
    const citado = contexto?.quotedMessage

    if (!citado) {
      return reply(
        `❌ Responda à mensagem do menu que você editou.\n\n` +
        `Copie o menu, altere os emojis/símbolos e depois responda essa mensagem com:\n` +
        `${config.prefix}editaremoji`
      )
    }

    const texto =
      citado?.conversation ||
      citado?.extendedTextMessage?.text ||
      citado?.imageMessage?.caption ||
      citado?.videoMessage?.caption ||
      ''

    if (!String(texto).trim()) {
      return reply('❌ Não consegui encontrar o texto do menu na mensagem respondida.')
    }

    const conteudo = String(texto).trim()
    const maiusculo = conteudo.toUpperCase()

    let tipo = 'principal'

    if (
      maiusculo.includes('DONO') ||
      maiusculo.includes('OWNER AREA') ||
      maiusculo.includes('OWNER')
    ) {
      tipo = 'dono'
    } else if (
      maiusculo.includes('PREMIUM') ||
      maiusculo.includes('VIP AREA') ||
      maiusculo.includes('VIP ROOM')
    ) {
      tipo = 'premium'
    } else if (
      maiusculo.includes('ADMINISTRAÇÃO & SEGURANÇA') ||
      maiusculo.includes('ADMIN & SEGURANÇA') ||
      maiusculo.includes('BACKSTAGE')
    ) {
      tipo = 'adm'
    }

    const db = await getDatabase()
    db.data.groups[groupJid] ||= {}
    db.data.groups[groupJid].menu ||= {}
    db.data.groups[groupJid].menu.menusPersonalizados ||= {}

    db.data.groups[groupJid].menu.menusPersonalizados[tipo] = conteudo

    await db.write()

    const nomes = {
      principal: 'PRINCIPAL',
      adm: 'ADM',
      premium: 'PREMIUM',
      dono: 'DONO',
    }

    return reply(
      `✅ *MENU ${nomes[tipo]} SALVO!*\n\n` +
      `A versão personalizada foi salva somente neste grupo.\n` +
      `Os emojis, símbolos e organização da mensagem foram preservados.`
    )
  },
}

